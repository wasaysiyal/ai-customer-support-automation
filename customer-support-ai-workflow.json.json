        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2:3b\",\n  \"stream\": false,\n  \"format\": \"json\",\n  \"prompt\": \"You are a customer support ticket classifier. Classify into exactly one category: Billing, Technical, Account, or General. Account: login, forgotten passwords, password resets, account access, profile updates. Billing: payments, charges, refunds, invoices, subscriptions. Technical: crashes, software bugs, upload failures, errors. General: all other enquiries. Priority: If login, password, password reset, or account access is mentioned, choose Account. If payment, refund, or charges are mentioned, choose Billing. If crashes, bugs, or application errors are mentioned, choose Technical. Return only valid JSON with keys category and explanation. Subject: {{ $json.subject }}. Message: {{ $json.message }}.\"\n}",
        "options": {}
