    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst aiResult = JSON.parse($json.response);\n\nconst ticket = $('Mock CRM Data').first().json;\n\nconst text = `${ticket.subject} ${ticket.message}`.toLowerCase();\n\nlet category = aiResult.category;\n\n// Account-related requests take priority\nif (/log ?in|login|sign ?in|password|forgot.*pass|reset.*pass|account access|cannot access.*account|unable to access.*account/.test(text)) {\n  category = 'Account';\n}\n// Billing-related requests\nelse if (/payment|refund|charged|charge|invoice|subscription|billing/.test(text)) {\n  category = 'Billing';\n}\n// Technical issues\nelse if (/crash|bug|error|upload failure|not working|technical/.test(text)) {\n  category = 'Technical';\n}\n// Everything else\nelse {\n  category = 'General';\n}\n\nreturn {\n  ...ticket,\n  category,\n  explanation: aiResult.explanation\n};\n"
      },
